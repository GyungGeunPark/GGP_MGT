<?xml version="1.0"?>
<package format="3">
  <name>sensor_cam_main</name>
  <version>0.1.0</version>
  <description>
    ROS2 package for camera-LiDAR fusion with YOLO v11 object detection using Python and C++ nodes.
  </description>

  <maintainer email="jyp7781@ff00ff.kr">jyp7781</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-onnxruntime</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
